<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>For Kids — Премиальные няни и домработницы</title>
<style>
  :root {
    --bg: #faf9f6;
    --text: #1a1a1a;
    --muted: #6b6b6b;
    --accent: #4a6c6f;
    --accent-hover: #385255;
    --card: #ffffff;
    --border: #e5e2d9;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: 'Inter', -apple-system, sans-serif; background: var(--bg); color: var(--text); line-height: 1.6; }
  h1, h2, h3 { font-family: 'Playfair Display', Georgia, serif; font-weight: 500; }
  a { text-decoration: none; color: inherit; }
  .container { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
  
  /* HERO */
  .hero { padding: 100px 0 80px; text-align: center; background: linear-gradient(180deg, #fff 0%, var(--bg) 100%); }
  .hero h1 { font-size: clamp(36px, 5vw, 56px); margin-bottom: 20px; color: var(--accent); }
  .hero p { font-size: 18px; color: var(--muted); max-width: 600px; margin: 0 auto 40px; }
  .btn-group { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .btn { display: inline-block; padding: 16px 32px; border-radius: 30px; font-weight: 600; font-size: 16px; transition: 0.2s; cursor: pointer; border: none; }
  .btn-primary { background: var(--accent); color: #fff; }
  .btn-primary:hover { background: var(--accent-hover); }
  .btn-outline { background: transparent; border: 1px solid var(--accent); color: var(--accent); }
  .btn-outline:hover { background: rgba(74, 108, 111, 0.05); }

  /* SECTIONS */
  section { padding: 80px 0; scroll-margin-top: 20px; }
  .section-title { text-align: center; font-size: 32px; margin-bottom: 40px; color: var(--accent); }
  
  /* STEPS */
  .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 30px; text-align: center; }
  .step .num { width: 50px; height: 50px; border-radius: 50%; background: #fff; border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: bold; color: var(--accent); margin: 0 auto 20px; }

  /* CATALOG */
  .catalog { background: #fff; }
  .grid-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; }
  .card { border: 1px solid var(--border); border-radius: 20px; overflow: hidden; background: var(--card); transition: 0.3s; }
  .card:hover { box-shadow: 0 10px 30px rgba(0,0,0,0.05); transform: translateY(-5px); }
  .card-img { height: 250px; background: #eaeaea; object-fit: cover; width: 100%; }
  .card-body { padding: 24px; }
  .card-name { font-size: 20px; margin-bottom: 5px; }
  .card-exp { color: var(--muted); font-size: 14px; margin-bottom: 10px; }
  .stars { color: #e8c469; font-size: 18px; margin-bottom: 15px; letter-spacing: 2px;}
  .card .btn { width: 100%; text-align: center; padding: 12px; border-radius: 12px; font-size: 14px; }

  /* SECURITY */
  .security { background: #f0f4f4; text-align: center; }
  .security-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 30px; margin-top: 30px; }
  .sec-item { padding: 20px; background: #fff; border-radius: 16px; border: 1px solid var(--border); }

  /* FORMS */
  .forms-wrapper { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  @media (max-width: 800px) { .forms-wrapper { grid-template-columns: 1fr; } }
  .form-box { background: #fff; padding: 40px; border-radius: 20px; border: 1px solid var(--border); }
  .form-box h3 { margin-bottom: 20px; font-size: 24px; }
  .form-group { margin-bottom: 20px; }
  .form-group label { display: block; margin-bottom: 8px; font-size: 14px; font-weight: 500; }
  .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 14px; border: 1px solid var(--border); border-radius: 10px; font-family: inherit; font-size: 15px; background: var(--bg); }
  .form-group input:focus, .form-group select:focus { outline: none; border-color: var(--accent); }
  .form-group input[type="file"] { padding: 10px; background: #fff; border: 1px dashed var(--border); }
  
  .success-msg { display: none; padding: 20px; background: #e3f0e8; color: #2e5c3e; border-radius: 10px; margin-top: 20px; text-align: center; font-weight: 500;}
  .loading { display: none; text-align: center; margin-top: 15px; color: var(--accent); }

  /* FOOTER */
  footer { background: #1a1a1a; color: #fff; padding: 40px 0; text-align: center; font-size: 14px; opacity: 0.8; }
  footer a { text-decoration: underline; }
</style>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet">
</head>
<body>

<!-- HERO -->
<div class="hero">
  <div class="container">
    <h1>Забота о вашем доме и детях</h1>
    <p>Премиальный сервис почасовых нянь и домработниц. Проверенные специалисты с опытом и рекомендациями.</p>
    <div class="btn-group">
      <a href="#client-form" class="btn btn-primary">Найти няню (Клиентам)</a>
      <a href="#worker-form" class="btn btn-outline">Стать няней (Соискателям)</a>
    </div>
  </div>
</div>

<!-- КАК ЭТО РАБОТАЕТ -->
<section>
  <div class="container">
    <h2 class="section-title">Как это работает</h2>
    <div class="steps">
      <div class="step"><div class="num">1</div><h3>Оставляете заявку</h3><p style="color:var(--muted);font-size:14px;">Заполняете форму с деталями</p></div>
      <div class="step"><div class="num">2</div><h3>Мы подбираем</h3><p style="color:var(--muted);font-size:14px;">Связываемся с вами в WhatsApp</p></div>
      <div class="step"><div class="num">3</div><h3>Оплата за час</h3><p style="color:var(--muted);font-size:14px;">Платите только за отработанное время</p></div>
      <div class="step"><div class="num">4</div><h3>Отзыв</h3><p style="color:var(--muted);font-size:14px;">Оцениваете работу специалиста</p></div>
    </div>
  </div>
</section>

<!-- КАТАЛОГ НЯНЬ (Генерируется через JS) -->
<section class="catalog" id="catalog">
  <div class="container">
    <h2 class="section-title">Наши специалисты</h2>
    <div class="grid-cards" id="nanny-catalog">
      <!-- Карточки будут вставлены через JavaScript -->
    </div>
  </div>
</section>

<!-- БЕЗОПАСНОСТЬ -->
<section class="security">
  <div class="container">
    <h2 class="section-title">Безопасность и доверие</h2>
    <p style="color:var(--muted); max-width: 600px; margin: 0 auto;">Мы тщательно проверяем каждую анкету, чтобы вы могли доверить нам самое ценное.</p>
    <div class="security-grid">
      <div class="sec-item">
        <h3 style="font-size:18px; margin-bottom:10px; color:var(--accent);">📄 Проверка документов</h3>
        <p style="font-size:14px; color:var(--muted);">У всех специалистов проверены паспорта, медкнижки и рекомендации с прошлых мест работы.</p>
      </div>
      <div class="sec-item">
        <h3 style="font-size:18px; margin-bottom:10px; color:var(--accent);">⭐ Реальные отзывы</h3>
        <p style="font-size:14px; color:var(--muted);">Мы собираем обратную связь после каждого заказа. Рейтинг формируется вручную на основе отзывов.</p>
      </div>
    </div>
  </div>
</section>

<!-- ФОРМЫ -->
<section style="background: var(--bg);">
  <div class="container">
    <div class="forms-wrapper">
      
      <!-- ФОРМА ДЛЯ КЛИЕНТОВ -->
      <div class="form-box" id="client-form">
        <h3>Заказать услугу</h3>
        <form id="form-client">
          <div class="form-group">
            <label>Ваше имя</label>
            <input type="text" name="name" placeholder="Екатерина" required>
          </div>
          <div class="form-group">
            <label>Телефон / WhatsApp</label>
            <input type="tel" name="phone" placeholder="+7 999 123-45-67" required>
          </div>
          <div class="form-group">
            <label>Какая услуга нужна?</label>
            <select name="service">
              <option value="Няня">Няня для ребенка</option>
              <option value="Домработница">Домработница (уборка)</option>
            </select>
          </div>
          <div class="form-group">
            <label>На сколько часов / когда?</label>
            <input type="text" name="time" placeholder="Сегодня, на 4 часа" required>
          </div>
          <div class="form-group">
            <label>Адрес (Район)</label>
            <input type="text" name="address" placeholder="м. Чистые пруды" required>
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;">Отправить заявку</button>
        </form>
        <div class="loading" id="load-client">Отправка данных...</div>
        <div class="success-msg" id="success-client">Спасибо! Ваша заявка принята. Мы свяжемся с вами в WhatsApp в течение 15 минут.</div>
      </div>

      <!-- ФОРМА ДЛЯ РАБОТНИКОВ -->
      <div class="form-box" id="worker-form">
        <h3>Анкета соискателя</h3>
        <form id="form-worker" enctype="multipart/form-data">
          <div class="form-group">
            <label>ФИО и Возраст</label>
            <input type="text" name="fio" placeholder="Иванова Анна, 28 лет" required>
          </div>
          <div class="form-group">
            <label>Телефон / WhatsApp</label>
            <input type="tel" name="phone" placeholder="+7 999 123-45-67" required>
          </div>
          <div class="form-group">
            <label>Опыт работы (лет)</label>
            <input type="number" name="experience" placeholder="5" required>
          </div>
          <div class="form-group">
            <label>Фото (аватар)</label>
            <input type="file" name="photo" accept="image/*" required>
          </div>
          <div class="form-group">
            <label>Резюме / Документы (PDF)</label>
            <input type="file" name="resume" accept=".pdf,.doc,.docx" required>
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;">Отправить анкету</button>
        </form>
        <div class="loading" id="load-worker">Загрузка файлов и отправка...</div>
        <div class="success-msg" id="success-worker">Спасибо! Ваша анкета отправлена на модерацию. Мы свяжемся с вами в WhatsApp.</div>
      </div>

    </div>
  </div>
</section>

<!-- FOOTER -->
<footer>
  <div class="container">
    <p>© 2026 For Kids. Все права защищены. ИП Иванов И.И.</p>
    <p style="margin-top:10px;">Telegram: <a href="https://t.me/forkids_admin">@forkids_admin</a> | WhatsApp: +7 999 000-00-00</p>
  </div>
</footer>

<script>
  /* ═══════════════════════════════════════════════════════════════
     1. ГЕНЕРАЦИЯ КАТАЛОГА (ИМИТАЦИЯ ДАННЫХ ИЗ AIRTABLE)
     ═══════════════════════════════════════════════════════════════ */
  // В будущем эти данные будут подтягиваться из Airtable API
  const nannies = [
    {
      name: "Анна, 28 лет",
      exp: "Опыт: 5 лет • Няня",
      rating: "★★★★★",
      desc: "Педагогическое образование, люблю детей, готовлю полезную еду.",
      img: "https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=600&q=80"
    },
    {
      name: "Мария, 35 лет",
      exp: "Опыт: 8 лет • Домработница",
      rating: "★★★★★",
      desc: "Профессиональный клининг, знаю все секреты чистоты. Аккуратная.",
      img: "https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=600&q=80"
    },
    {
      name: "Елена, 24 года",
      exp: "Опыт: 3 года • Няня",
      rating: "★★★★☆",
      desc: "Знаю английский, играю в развивающие игры, легко нахожу контакт.",
      img: "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=600&q=80"
    }
  ];

  const catalogContainer = document.getElementById('nanny-catalog');
  
  nannies.forEach(person => {
    const card = document.createElement('div');
    card.className = 'card';
    card.innerHTML = `
      <img src="${person.img}" class="card-img" alt="${person.name}">
      <div class="card-body">
        <div class="card-name">${person.name}</div>
        <div class="card-exp">${person.exp}</div>
        <div class="stars">${person.rating}</div>
        <p style="font-size:14px;color:var(--muted);margin-bottom:15px;">${person.desc}</p>
        <a href="#client-form" class="btn btn-outline">Нанять</a>
      </div>
    `;
    catalogContainer.appendChild(card);
  });

  /* ═══════════════════════════════════════════════════════════════
     2. ОТПРАВКА ФОРМ В MAKE.COM (WEBHOOK)
     ═══════════════════════════════════════════════════════════════ */
  // ⚠️ ВСТАВЬ СЮДА ССЫЛКИ ИЗ MAKE.COM
const MAKE_WEBHOOK_CLIENT = "https://hook.eu1.make.com/4x613h1ghcs7851ngz5501gzkls03dsd";


  // Обработка формы клиента
  document.getElementById('form-client').addEventListener('submit', function(e) {
    e.preventDefault();
    const form = this;
    const btn = form.querySelector('button');
    const loader = document.getElementById('load-client');
    const success = document.getElementById('success-client');

    btn.disabled = true;
    loader.style.display = 'block';

    const formData = new FormData(form);
    
    // Отправляем данные (простой JSON)
    fetch(MAKE_WEBHOOK_CLIENT, {
      method: 'POST',
      body: formData
    })
    .then(res => {
      form.style.display = 'none';
      loader.style.display = 'none';
      success.style.display = 'block';
    })
    .catch(err => {
      alert("Ошибка отправки. Пожалуйста, попробуйте позже.");
      btn.disabled = false;
      loader.style.display = 'none';
    });
  });

  // Обработка формы работника (с файлами)
  document.getElementById('form-worker').addEventListener('submit', function(e) {
    e.preventDefault();
    const form = this;
    const btn = form.querySelector('button');
    const loader = document.getElementById('load-worker');
    const success = document.getElementById('success-worker');

    btn.disabled = true;
    loader.style.display = 'block';

    const formData = new FormData(form);
    
    // Отправляем данные (файлы уйдут как multipart/form-data)
    fetch(MAKE_WEBHOOK_WORKER, {
      method: 'POST',
      body: formData
    })
    .then(res => {
      form.style.display = 'none';
      loader.style.display = 'none';
      success.style.display = 'block';
    })
    .catch(err => {
      alert("Ошибка загрузки файлов. Проверьте интернет.");
      btn.disabled = false;
      loader.style.display = 'none';
    });
  });
</script>
</body>
</html>
